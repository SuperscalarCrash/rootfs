#!/bin/sh
set -eu

required_files="
/root/.bash_profile
/root/.bashrc
/root/.config/fastfetch/config.jsonc
/root/.fluxbox/init
/root/.fluxbox/menu
/root/.fluxbox/overlay
/root/.fluxbox/startup
/root/.xsession
/etc/X11/xorg.conf.d/10-gemmont-fbdev.conf
/etc/default/nodm
/usr/share/fonts/dejavu/DejaVuSans.ttf
/usr/lib/libffi.so.8
/usr/share/fastfetch/logos/zju-qiushi-eagle.txt
"

required_executables="
/bin/busybox
/bin/bash
/lib32/ld-linux-loongarch-ilp32s.so.1
/lib32/sf/libc.so.6
/usr/bin/coremark
/usr/bin/dhrystone
/usr/bin/adb
/usr/bin/adbd
/usr/bin/evtest
/usr/bin/fastfetch
/usr/bin/fb-test
/usr/bin/fb-test-offset
/usr/bin/fb-test-perf
/usr/bin/fb-test-rect
/usr/bin/fb-test-string
/usr/bin/fbdump
/usr/bin/fbv
/usr/bin/Xorg
/usr/bin/setxkbmap
/usr/bin/startx
/usr/bin/xauth
/usr/bin/xcalc
/usr/bin/xclock
/usr/bin/xdpyinfo
/usr/bin/xedit
/usr/bin/xev
/usr/bin/xeyes
/usr/bin/xinit
/usr/bin/xinput
/usr/bin/xkill
/usr/bin/xload
/usr/bin/xlogo
/usr/bin/xmessage
/usr/bin/xprop
/usr/bin/xrandr
/usr/bin/xrdb
/usr/bin/xset
/usr/bin/xsetroot
/usr/bin/xterm
/usr/bin/xwininfo
/usr/bin/xwd
/usr/bin/xwud
/usr/bin/startfluxbox
/usr/bin/fluxbox
/usr/sbin/nodm
/etc/init.d/S90nodm
/bin/grep
/usr/bin/zstd
/usr/bin/htop
/usr/bin/rz
/usr/bin/sz
/usr/bin/tmux
/usr/bin/tree
/usr/bin/vim
/usr/bin/gcc
/usr/bin/as
/usr/bin/ld
/usr/bin/ssh
/usr/bin/ssh-keygen
/usr/sbin/sshd
/usr/sbin/nginx
/usr/bin/ntpdate
/usr/sbin/ntpd
/sbin/dhclient
/sbin/dhclient-script
/bin/ping
/usr/sbin/arping
/usr/bin/clockdiff
/usr/bin/tracepath
/usr/bin/python3
/usr/sbin/mtdinfo
/usr/sbin/ubiattach
/usr/sbin/ubiformat
"

for path in ${required_files}; do
	if [ ! -f "${path}" ]; then
		echo "rootfs self-test: missing file ${path}" >&2
		exit 1
	fi
done

if ! grep -Eq '^[[:space:]]*Option[[:space:]]+"fbdev"[[:space:]]+"/dev/fb0"' \
	/etc/X11/xorg.conf.d/10-gemmont-fbdev.conf; then
	echo "rootfs self-test: Xorg is not pinned to VGA /dev/fb0" >&2
	exit 1
fi

if ! grep -qx 'NODM_XSESSION=/root/.xsession' /etc/default/nodm; then
	echo "rootfs self-test: nodm does not start the root Fluxbox session" >&2
	exit 1
fi
if ! grep -qx 'NODM_X_OPTIONS="-nolisten tcp -s 0"' /etc/default/nodm; then
	echo "rootfs self-test: nodm does not keep Xorg local-only" >&2
	exit 1
fi

for path in ${required_executables}; do
	if [ ! -x "${path}" ]; then
		echo "rootfs self-test: missing executable ${path}" >&2
		exit 1
	fi
done

for nameserver in 223.5.5.5 8.8.8.8; do
	if ! grep -qx "nameserver ${nameserver}" /etc/resolv.conf; then
		echo "rootfs self-test: missing static DNS server ${nameserver}" >&2
		exit 1
	fi
done

if [ "$(awk -F: '$1 == "root" { print $7 }' /etc/passwd)" != /bin/bash ]; then
	echo "rootfs self-test: root login shell is not Bash" >&2
	exit 1
fi

if ! grep -Eq \
	'^ttyS0::respawn:/sbin/getty[[:space:]]+-L[[:space:]]+ttyS0[[:space:]]+115200[[:space:]]+vt100([[:space:]]|$)' \
	/etc/inittab; then
	echo "rootfs self-test: serial ttyS0 getty is missing" >&2
	exit 1
fi

if [ "$(grep -Ec '^tty1::respawn:/sbin/getty -L tty1 0 linux # GEMMONT_FRAMEBUFFER$' \
	/etc/inittab)" -ne 1 ]; then
	echo "rootfs self-test: framebuffer tty1 getty is missing or duplicated" >&2
	exit 1
fi

case "$(/bin/bash --version | sed -n '1p')" in
	'GNU bash, version 5.2.37'*)
		;;
	*)
		echo "rootfs self-test: unexpected Bash version" >&2
		exit 1
		;;
esac

case "$(fastfetch --version)" in
	'fastfetch 2.66.0 '*)
		;;
	*)
		echo "rootfs self-test: unexpected Fastfetch version" >&2
		exit 1
		;;
esac

case "$(/lib32/sf/libc.so.6 | sed -n '1p')" in
	'GNU C Library (GNU libc) stable release version 2.44.'*)
		;;
	*)
		echo "rootfs self-test: unexpected glibc version" >&2
		exit 1
		;;
esac

if [ "$(gcc -dumpfullversion)" != 16.1.0 ]; then
	echo "rootfs self-test: unexpected GCC version" >&2
	exit 1
fi

if [ "$(gcc -dumpmachine)" != loongarch32-linux-gnusf ]; then
	echo "rootfs self-test: unexpected GCC target" >&2
	exit 1
fi

/usr/sbin/sshd -t

if command -v ip >/dev/null 2>&1; then
	ip link show >/dev/null
fi

if [ -r /proc/mtd ]; then
	echo "rootfs self-test: detected MTD layout"
	cat /proc/mtd
fi

echo "rootfs self-test: PASS ($(uname -m), $(busybox | sed -n '1p'))"
